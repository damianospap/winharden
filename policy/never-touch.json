  "cleanup": {
    "notice": "Deny by default: a file_cleanup operation may name only a folder listed here, with the same scope. Folders are deliberately limited to caches, temporary files and diagnostic logs that Windows recreates. Nothing here is under Windows Update, servicing, the component store, the Store, Defender or the event logs.",
    "roots": [
      { "scope": "machine", "path": "%SystemRoot%\\Temp" },
      { "scope": "machine", "path": "%SystemRoot%\\Minidump" },
      { "scope": "machine", "path": "%ProgramData%\\Microsoft\\Windows\\WER\\ReportArchive" },
      { "scope": "machine", "path": "%ProgramData%\\Microsoft\\Windows\\WER\\ReportQueue" },
      { "scope": "user", "path": "%LocalAppData%\\Temp" },
      { "scope": "user", "path": "%LocalAppData%\\CrashDumps" },
      { "scope": "user", "path": "%LocalAppData%\\Microsoft\\Windows\\WER" }
    ]
  }
