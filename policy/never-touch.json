{
  "schema_version": 1,
  "notice": "Hardcoded safety policy. A manifest entry that touches anything listed here is rejected by the validator (CI) and must be rejected again by the engine at runtime. Editing this file is a code change and needs review. Matching is case-insensitive.",

  "services": [
    "wuauserv", "UsoSvc", "WaaSMedicSvc", "BITS", "TrustedInstaller", "CryptSvc",
    "msiserver", "ClipSVC", "AppXSvc", "InstallService", "LicenseManager",
    "edgeupdate", "edgeupdatem",
    "WinDefend", "WdNisSvc", "WdNisDrv", "WdFilter", "WdBoot", "SecurityHealthService", "wscsvc",
    "mpssvc", "BFE",
    "BDESVC", "wlidsvc", "TokenBroker", "TBS",
    "EventLog", "RpcSs", "RpcEptMapper", "DcomLaunch", "Winmgmt", "Schedule", "ProfSvc", "gpsvc"
  ],

  "registry_prefixes": [
    { "hive": "HKLM", "path": "SYSTEM\\CurrentControlSet\\Control\\SecureBoot",
      "reason": "Secure Boot state and certificate servicing" },
    { "hive": "HKLM", "path": "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\WindowsUpdate",
      "reason": "Windows Update client state" },
    { "hive": "HKLM", "path": "SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate",
      "reason": "Windows Update policy" },
    { "hive": "HKLM", "path": "SOFTWARE\\Policies\\Microsoft\\FVE",
      "reason": "BitLocker policy and recovery key escrow" },
    { "hive": "HKLM", "path": "SYSTEM\\CurrentControlSet\\Control\\BitLocker",
      "reason": "BitLocker / Device Encryption state" },
    { "hive": "HKLM", "path": "SOFTWARE\\Policies\\Microsoft\\TPM",
      "reason": "TPM policy" },
    { "hive": "HKLM", "path": "SOFTWARE\\Policies\\Microsoft\\WindowsStore",
      "reason": "Microsoft Store policy" },
    { "hive": "HKLM", "path": "SOFTWARE\\Policies\\Microsoft\\EdgeUpdate",
      "reason": "Edge and WebView2 Runtime updater policy" },
    { "hive": "HKLM", "path": "SOFTWARE\\Microsoft\\EdgeUpdate",
      "reason": "Edge and WebView2 Runtime updater state" },
    { "hive": "HKLM", "path": "SOFTWARE\\Microsoft\\WindowsUpdate",
      "reason": "Windows Update orchestration state" }
  ],

  "registry_values": [
    { "hive": "HKLM", "path_prefix": "SOFTWARE\\Policies\\Microsoft\\Windows Defender",
      "names": [
        "DisableAntiSpyware", "DisableAntiVirus", "DisableRealtimeMonitoring",
        "DisableBehaviorMonitoring", "DisableOnAccessProtection", "DisableIOAVProtection",
        "DisableScanOnRealtimeEnable", "DisableRoutinelyTakingAction", "DisableBlockAtFirstSeen",
        "SpynetReporting", "SubmitSamplesConsent", "MAPSReporting", "ServiceKeepAlive"
      ],
      "reason": "Defender engine stays on; cloud protection and sample submission stay on (hardening only)" },
    { "hive": "HKLM", "path_prefix": "SOFTWARE\\Microsoft\\Windows Defender",
      "names": [
        "DisableAntiSpyware", "DisableAntiVirus", "DisableRealtimeMonitoring",
        "DisableBehaviorMonitoring", "DisableOnAccessProtection", "DisableIOAVProtection",
        "SpynetReporting", "SubmitSamplesConsent", "TamperProtection"
      ],
      "reason": "Defender engine state and Tamper Protection" },
    { "hive": "HKLM", "path_prefix": "SOFTWARE\\Policies\\Microsoft\\Windows\\System",
      "names": ["EnableSmartScreen", "ShellSmartScreenLevel"],
      "reason": "SmartScreen stays on" },
    { "hive": "HKLM", "path_prefix": "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Explorer",
      "names": ["SmartScreenEnabled"],
      "reason": "SmartScreen stays on" },
    { "hive": "HKLM", "path_prefix": "SOFTWARE\\Policies\\Microsoft\\Edge",
      "names": ["SmartScreenEnabled", "SmartScreenPuaEnabled", "PreventSmartScreenPromptOverride"],
      "reason": "SmartScreen stays on" },
    { "hive": "HKCU", "path_prefix": "Software\\Microsoft\\Windows\\CurrentVersion\\AppHost",
      "names": ["EnableWebContentEvaluation", "PreventOverride"],
      "reason": "SmartScreen for apps stays on" },
    { "hive": "HKLM", "path_prefix": "SYSTEM\\CurrentControlSet\\Control\\CI\\Config",
      "names": ["VulnerableDriverBlocklistEnable"],
      "reason": "Vulnerable driver blocklist stays on" }
  ],

  "appx_names": [
    "Microsoft.WindowsStore", "Microsoft.StorePurchaseApp", "Microsoft.DesktopAppInstaller",
    "Microsoft.Services.Store.Engagement",
    "Microsoft.WindowsAppRuntime.*", "Microsoft.UI.Xaml.*", "Microsoft.VCLibs.*", "Microsoft.NET.Native.*",
    "Microsoft.Win32WebViewHost", "Microsoft.Windows.CloudExperienceHost",
    "Microsoft.AAD.BrokerPlugin", "Microsoft.AccountsControl",
    "Microsoft.Windows.ShellExperienceHost", "Microsoft.Windows.StartMenuExperienceHost",
    "Microsoft.SecHealthUI", "Microsoft.Windows.SecHealthUI", "Microsoft.Windows.Search",
    "MicrosoftWindows.Client.CBS", "MicrosoftWindows.Client.Core",
    "MicrosoftWindows.Client.FileExp", "MicrosoftWindows.Client.OOBE"
  ],

  "scheduled_tasks": [
    "\\Microsoft\\Windows\\WindowsUpdate\\*",
    "\\Microsoft\\Windows\\UpdateOrchestrator\\*",
    "\\Microsoft\\Windows\\WaaSMedic\\*",
    "\\Microsoft\\Windows\\Servicing\\*",
    "\\Microsoft\\Windows\\InstallService\\*",
    "\\Microsoft\\Windows\\Windows Defender\\*",
    "\\Microsoft\\Windows\\BitLocker\\*",
    "\\Microsoft\\Windows\\TPM\\*",
    "\\Microsoft\\Windows\\PI\\*",
    "\\Microsoft\\Windows\\SoftwareProtectionPlatform\\*",
    "\\Microsoft\\Windows\\Clip\\*",
    "\\Microsoft\\Windows\\License Manager\\*",
    "\\MicrosoftEdgeUpdateTaskMachine*"
  ],

  "optional_features": [
    "Windows-Defender-Default-Definitions"
  ],

  "servicing_adjacent": {
    "services": ["DoSvc"],
    "scheduled_tasks": [
      "\\Microsoft\\Windows\\Application Experience\\Microsoft Compatibility Appraiser"
    ]
  },

